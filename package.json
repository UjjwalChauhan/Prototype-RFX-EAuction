{
  "name": "rfx-eauction",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Configurable RFx & E-Auction module — Admin Platform + Vendor Portal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync": "node sync-server.mjs",
    "api": "node api-server.mjs",
    "dev:portal": "vite --config vite.portal.config.ts",
    "dev:all": "node api-server.mjs & vite & vite --config vite.portal.config.ts",
    "build:portal": "vite build --config vite.portal.config.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
